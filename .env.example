# =====================================================================
# AgriSmart AI - Environment Configuration Template
# SIH-2026 Problem Statement 1
# =====================================================================
# Copy this file to .env and customize for your local or production setup:
#   copy .env.example .env
#
# IMPORTANT: Never commit your real .env file or production credentials to Git!
# =====================================================================

# ---------------------------------------------------------------------
# 1. Server Configuration
# ---------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# ---------------------------------------------------------------------
# 2. Database Configuration (Local SQLite / Distributed)
# ---------------------------------------------------------------------
# Path to local SQLite database (default: agrismart.db in project root)
AGRISMART_DB_PATH=agrismart.db

# ---------------------------------------------------------------------
# 3. Supabase Cloud PostgreSQL Synchronization
# ---------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# Your Supabase Anon or Service Role API Key (starts with eyJhbGci...)
SUPABASE_KEY=

# ---------------------------------------------------------------------
# 4. Enterprise Tiered Rate Limiting Configuration
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# Public unauthenticated browsing limit (requests per window)
RATE_LIMIT_PUBLIC_IP_MAX=180
RATE_LIMIT_PUBLIC_IP_WINDOW=60

# Authenticated logged-in farmer action limit (requests per window)
RATE_LIMIT_AUTHED_USER_MAX=300
RATE_LIMIT_AUTHED_USER_WINDOW=60

# Authentication route protection (login, register, password change/reset)
RATE_LIMIT_AUTH_IP_MAX=30
RATE_LIMIT_AUTH_IP_WINDOW=60
RATE_LIMIT_AUTH_ACCOUNT_THRESHOLD=5
RATE_LIMIT_AUTH_IP_BACKOFF_THRESHOLD=15
RATE_LIMIT_AUTH_BACKOFF_BASE=2.0
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2.0
RATE_LIMIT_AUTH_BACKOFF_MAX=300.0

# ---------------------------------------------------------------------
# 5. External LLM / Agronomy Assistant (Optional)
# ---------------------------------------------------------------------
# If configuring external Gemini API / Google GenAI models
GEMINI_API_KEY=
